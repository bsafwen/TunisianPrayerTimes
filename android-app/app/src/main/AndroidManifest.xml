<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to modify Do Not Disturb settings -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Required for exact alarms (setAlarmClock) on Android 12+ -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-schedule alarms after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Request exemption from battery optimization (needed to prevent app hibernation) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Fine location allows GPS/high-accuracy auto-detection when available -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Coarse location for auto-detecting nearest delegation -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Internet access for fetching Ramadan override JSON -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vibrate when silence period ends to alert about suppressed notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Run wake alarm playback as a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required for media playback foreground services on newer Android versions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Needed on Android 13+ so wake playback notifications can surface normally -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Allow wake alarms to present as full-screen alarm UI when permitted by the system -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Needed to observe phone call state changes -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- We don't use advertising; remove AD_ID added transitively by Firebase/Play Services -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- Gyroscope Maze wake-up challenge uses the device orientation sensor.
         Marked required=false so devices without a gyroscope are not filtered from the store;
         the game falls back gracefully when no orientation sensor is available. -->
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:layoutDirection="rtl"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TunisianPrayerTimes">

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.TunisianPrayerTimes" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Internal receiver for silence/unsilence/reschedule alarms -->
        <receiver
            android:name=".SilenceReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tunisianprayertimes.ACTION_SILENCE" />
                <action android:name="com.tunisianprayertimes.ACTION_UNSILENCE" />
                <action android:name="com.tunisianprayertimes.ACTION_RESCHEDULE" />
            </intent-filter>
        </receiver>

        <!-- System broadcast receiver for boot/update (must be exported) -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- System broadcast receiver for phone state changes -->
        <receiver
            android:name=".PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".wake.WakeAlertActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:theme="@style/Theme.TunisianPrayerTimes"
            android:turnScreenOn="true" />

        <service
            android:name=".wake.WakePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".wake.WakeActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".wake.WakeAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".wake.AwakeCheckReceiver"
            android:exported="false" />

        <service
            android:name=".wake.AwakeCheckService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />


    </application>

</manifest>

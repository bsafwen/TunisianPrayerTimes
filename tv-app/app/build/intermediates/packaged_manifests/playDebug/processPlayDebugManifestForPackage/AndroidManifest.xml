<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: every screen at any moment, for checking the design on an emulator. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tunisianprayertimes.tv.dev"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="36" />
    <!-- Keep screen on -->
    <uses-permission android:name="android.permission.WAKE_LOCK" /> <!-- Boot completed to auto-start -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" /> <!-- "Display over other apps": what lets Android 10+ bring the display back at boot and after Home -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
 No storage permission: a USB key is read in the app's own Android/data/<package>/files folder,
         which needs none (usb/UsbVolumes.kt)
    -->
    <!-- Optional: official Ramadan/Eid date announcements. Prayer times need no network. -->
    <uses-permission android:name="android.permission.INTERNET" /> <!-- Whether the TV is online, before asking for the weather or an update -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> <!-- Declare this is a TV app -->
    <!-- Not required: many AOSP mosque boxes do not declare leanback, and the app must install there too -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" /> <!-- TV apps don't require touchscreen -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" /> <!-- Android 11+: to recognise the box's home screen (Fire TV's, a TV's) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The other build (Play or GitHub): installed beside this one, the two fight over the screen -->
        <package android:name="com.tunisianprayertimes.tv.github" />
    </queries>

    <permission
        android:name="com.tunisianprayertimes.tv.dev.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.tunisianprayertimes.tv.dev.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.tunisianprayertimes.tv.TvApplication"
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:layoutDirection="rtl"
        android:supportsRtl="true"
        android:theme="@style/Theme.TunisianPrayerTimesTV" >
        <activity
            android:name="com.tunisianprayertimes.tv.ScreenGalleryActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="landscape"
            android:taskAffinity=".gallery"
            android:theme="@style/Theme.TunisianPrayerTimesTV" />
        <!-- The virtual canvas fits any size or density: a new output mode (TV switched off and on) does not recreate it -->
        <activity
            android:name="com.tunisianprayertimes.tv.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|fontScale|locale|layoutDirection|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity> <!-- Home mode, off until the admin turns it on from the kiosk page: the box then boots into the display -->
        <activity-alias
            android:name="com.tunisianprayertimes.tv.KioskHomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity="com.tunisianprayertimes.tv.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!--
 Auto-start on boot. The boot broadcast reaches apps one after another (Android 15 and before):
             the highest priority an app may have puts the display ahead of the box's own apps.
        -->
        <receiver
            android:name="com.tunisianprayertimes.tv.BootReceiver"
            android:exported="true" >
            <intent-filter android:priority="999" >
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver> <!-- Watchdog and after-boot check alarms -->
        <receiver
            android:name="com.tunisianprayertimes.tv.kiosk.KioskAlarmReceiver"
            android:exported="false" />
        <!--
 The system clock or zone was changed (by the admin, the network or the app): the clock guard's
             confirmation no longer holds. Both are system broadcasts that still reach manifest receivers.
        -->
        <receiver
            android:name="com.tunisianprayertimes.tv.kiosk.ClockChangeReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver> <!-- Only used when an installer provisions the box as device owner (lock task) -->
        <receiver
            android:name="com.tunisianprayertimes.tv.kiosk.TvDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN" >
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="org.jetbrains.compose.resources.AndroidContextProvider"
            android:authorities="com.tunisianprayertimes.tv.dev.resources.AndroidContextProvider"
            android:enabled="true"
            android:exported="false" >
        </provider>

        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="true" />

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.tunisianprayertimes.tv.dev.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
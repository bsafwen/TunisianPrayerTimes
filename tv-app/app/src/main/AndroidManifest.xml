<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keep screen on -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Boot completed to auto-start -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Display over other apps": what lets Android 10+ bring the display back at boot and after Home -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- No storage permission: a USB key is read in the app's own Android/data/<package>/files folder,
         which needs none (usb/UsbVolumes.kt) -->
    <!-- Optional: official Ramadan/Eid date announcements. Prayer times need no network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the TV is online, before asking for the weather or an update -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Explicitly opt out: this app does not use full-screen intent alarms -->
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:node="remove" />


    <!-- Declare this is a TV app -->
    <!-- Not required: many AOSP mosque boxes do not declare leanback, and the app must install there too -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- TV apps don't require touchscreen -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Android 11+: to recognise the box's home screen (Fire TV's, a TV's) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The other build (Play or GitHub): installed beside this one, the two fight over the screen -->
        <package android:name="${otherBuild}" />
    </queries>

    <!-- No backup, and no transfer to a new device: the clock guard's correction and confirmation belong
         to this box's clock alone. A mosque's settings move between TVs with the USB file or the phone. -->
    <application
        android:name=".TvApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:layoutDirection="rtl"
        android:supportsRtl="true"
        android:theme="@style/Theme.TunisianPrayerTimesTV">

        <!-- The virtual canvas fits any size or density: a new output mode (TV switched off and on) does not recreate it -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|fontScale|locale|layoutDirection|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home mode, off until the admin turns it on from the kiosk page: the box then boots into the display -->
        <activity-alias
            android:name=".KioskHomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Auto-start on boot. The boot broadcast reaches apps one after another (Android 15 and before):
             the highest priority an app may have puts the display ahead of the box's own apps. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Watchdog and after-boot check alarms -->
        <receiver
            android:name=".kiosk.KioskAlarmReceiver"
            android:exported="false" />

        <!-- The system clock or zone was changed (by the admin, the network or the app): the clock guard's
             confirmation no longer holds. Both are system broadcasts that still reach manifest receivers. -->
        <receiver
            android:name=".kiosk.ClockChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Only used when an installer provisions the box as device owner (lock task) -->
        <receiver
            android:name=".kiosk.TvDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to modify Do Not Disturb settings -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Required for exact alarms (setAlarmClock) on Android 12+ -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-schedule alarms after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Request exemption from battery optimization (needed to prevent app hibernation) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Fine location allows GPS/high-accuracy auto-detection when available -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Coarse location for auto-detecting nearest delegation -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Internet access for fetching Ramadan override JSON -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vibrate when silence period ends to alert about suppressed notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Needed to observe phone call state changes -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- We don't use advertising; remove AD_ID added transitively by Firebase/Play Services -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:layoutDirection="rtl"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TunisianPrayerTimes">

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.TunisianPrayerTimes" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Internal receiver for silence/unsilence/reschedule alarms -->
        <receiver
            android:name=".SilenceReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tunisianprayertimes.ACTION_SILENCE" />
                <action android:name="com.tunisianprayertimes.ACTION_UNSILENCE" />
                <action android:name="com.tunisianprayertimes.ACTION_RESCHEDULE" />
            </intent-filter>
        </receiver>

        <!-- System broadcast receiver for boot/update (must be exported) -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- System broadcast receiver for phone state changes -->
        <receiver
            android:name=".PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>


    </application>

</manifest>

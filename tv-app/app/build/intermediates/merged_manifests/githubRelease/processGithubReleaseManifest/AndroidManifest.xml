<?xml version="1.0" encoding="utf-8"?>
<!-- The GitHub build only: it installs its own updates, which the Play build must never do. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tunisianprayertimes.tv.github"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: an app updating itself may do it without a confirmation dialog -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!--
         Granted once with adb (Fire TV has no settings page for it): lets the kiosk page turn the quick-start
         service on, put it back after a force stop, and turn off Fire TV's sleep timer
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- Keep screen on -->
    <uses-permission android:name="android.permission.WAKE_LOCK" /> <!-- Boot completed to auto-start -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" /> <!-- "Display over other apps": what lets Android 10+ bring the display back at boot and after Home -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" /> <!-- Read custom backgrounds & announcements from external storage -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" /> <!-- Optional: official Ramadan/Eid date announcements. Prayer times need no network. -->
    <uses-permission android:name="android.permission.INTERNET" /> <!-- Whether the TV is online, before asking for the weather or an update -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> <!-- Declare this is a TV app -->
    <!-- Not required: many AOSP mosque boxes do not declare leanback, and the app must install there too -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" /> <!-- TV apps don't require touchscreen -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" /> <!-- Android 11+: to recognise the box's home screen (Fire TV's, a TV's) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <permission
        android:name="com.tunisianprayertimes.tv.github.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.tunisianprayertimes.tv.github.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.tunisianprayertimes.tv.TvApplication"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:banner="@drawable/tv_banner"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:layoutDirection="rtl"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.TunisianPrayerTimesTV" >
        <receiver
            android:name="com.tunisianprayertimes.tv.update.InstallResultReceiver"
            android:exported="false" />

        <!-- Quick start: bound by the system right after boot; see kiosk/KioskAccessibility.kt -->
        <service
            android:name="com.tunisianprayertimes.tv.kiosk.KioskAccessibilityService"
            android:exported="true"
            android:label="@string/quick_start_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kiosk_accessibility" />
        </service>

        <activity
            android:name="com.tunisianprayertimes.tv.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity> <!-- Home mode, off until the admin turns it on from the kiosk page: the box then boots into the display -->
        <activity-alias
            android:name="com.tunisianprayertimes.tv.KioskHomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity="com.tunisianprayertimes.tv.MainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!--
 Auto-start on boot. The boot broadcast reaches apps one after another (Android 15 and before):
             the highest priority an app may have puts the display ahead of the box's own apps.
        -->
        <receiver
            android:name="com.tunisianprayertimes.tv.BootReceiver"
            android:exported="true" >
            <intent-filter android:priority="999" >
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver> <!-- Watchdog and after-boot check alarms -->
        <receiver
            android:name="com.tunisianprayertimes.tv.kiosk.KioskAlarmReceiver"
            android:exported="false" /> <!-- Only used when an installer provisions the box as device owner (lock task) -->
        <receiver
            android:name="com.tunisianprayertimes.tv.kiosk.TvDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN" >
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="org.jetbrains.compose.resources.AndroidContextProvider"
            android:authorities="com.tunisianprayertimes.tv.github.resources.AndroidContextProvider"
            android:enabled="true"
            android:exported="false" >
        </provider>

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.tunisianprayertimes.tv.github.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<!-- The GitHub build only: it installs its own updates, which the Play build must never do. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: an app updating itself may do it without a confirmation dialog -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Granted once with adb (Fire TV has no settings page for it): lets the kiosk page turn the quick-start
         service on, put it back after a force stop, and turn off Fire TV's sleep timer -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application>
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- Quick start: bound by the system right after boot; see kiosk/KioskAccessibility.kt -->
        <service
            android:name=".kiosk.KioskAccessibilityService"
            android:exported="true"
            android:label="@string/quick_start_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kiosk_accessibility" />
        </service>
    </application>

</manifest>
